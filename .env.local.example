# Example Local Environment Configuration (Server-Side Only)
# Copy this file to .env.local and add your actual API keys
#
# ⚠️  SECURITY WARNING: This file contains sensitive API keys
# ✅ Always keep .env.local in .gitignore (it's already ignored)
# ❌ NEVER commit .env.local to version control

# =============================================================================
# REQUIRED API KEYS (Add your actual keys here)
# =============================================================================

# Content API authentication key for backend requests
# Replace with your actual content API key
CONTENT_API_KEY=your_actual_content_api_key_here

# Backend API URL (adjust for your environment)
BACKEND_API_URL=http://127.0.0.1:2024

# API Base URL for client-side requests (accessible in browser)
# This MUST have NEXT_PUBLIC_ prefix to be accessible in client-side code
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:2024

# Development environment
NODE_ENV=development

# =============================================================================
# AUTHENTICATION (AuthJS / next-auth v5)
# =============================================================================

# AuthJS Secret (Generate with: npx auth secret)
# This is used to encrypt JWT tokens and sessions
# IMPORTANT: Generate a new secret for production
AUTH_SECRET=your_generated_auth_secret_here

# AuthJS URL (for production deployments)
# Leave blank for local development (auto-detected)
# AUTH_URL=https://yourdomain.com

# =============================================================================
# OAUTH PROVIDERS (Google & GitHub)
# =============================================================================

# Google OAuth (Get from: https://console.developers.google.com/apis/credentials)
# 1. Create OAuth 2.0 Client ID
# 2. Add authorized redirect URI: http://localhost:3000/api/auth/callback/google
# 3. For production: https://yourdomain.com/api/auth/callback/google
AUTH_GOOGLE_ID=your_google_client_id_here
AUTH_GOOGLE_SECRET=your_google_client_secret_here

# GitHub OAuth (Get from: https://github.com/settings/developers)
# 1. Create new OAuth App
# 2. Homepage URL: http://localhost:3000
# 3. Authorization callback URL: http://localhost:3000/api/auth/callback/github
# 4. For production: https://yourdomain.com/api/auth/callback/github
AUTH_GITHUB_ID=your_github_client_id_here
AUTH_GITHUB_SECRET=your_github_client_secret_here

# =============================================================================
# AI PROVIDER API KEYS (Required for AI features)
# =============================================================================

# Anthropic API Key (for Claude models)
# Get from: https://console.anthropic.com/
# Format: sk-ant-api03-...
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Perplexity API Key (for research features)
# Get from: https://www.perplexity.ai/settings/api
# Format: pplx-...
PERPLEXITY_API_KEY=your_perplexity_api_key_here

# =============================================================================
# OPTIONAL API KEYS (Add only if needed)
# =============================================================================

# OpenAI API Key (for GPT models)
# Get from: https://platform.openai.com/api-keys
# Format: sk-proj-... or sk-...
# OPENAI_API_KEY=your_openai_api_key_here

# Google AI API Key (for Gemini models)
# Get from: https://makersuite.google.com/app/apikey
# GOOGLE_API_KEY=your_google_api_key_here

# Mistral AI API Key
# Get from: https://console.mistral.ai/
# MISTRAL_API_KEY=your_mistral_api_key_here

# xAI API Key (for Grok models)
# Get from: https://x.ai/
# XAI_API_KEY=your_xai_api_key_here

# Groq API Key (for fast inference)
# Get from: https://console.groq.com/keys
# GROQ_API_KEY=your_groq_api_key_here

# OpenRouter API Key (for multiple models)
# Get from: https://openrouter.ai/keys
# OPENROUTER_API_KEY=your_openrouter_api_key_here

# Azure OpenAI API Key
# Get from: Azure Portal
# AZURE_OPENAI_API_KEY=your_azure_openai_api_key_here

# Ollama API Key (for remote Ollama servers)
# Only needed for remote servers requiring authentication
# OLLAMA_API_KEY=your_ollama_api_key_here

# GitHub API Key (for import/export features)
# Get from: https://github.com/settings/tokens
# Format: ghp_... or github_pat_...
# GITHUB_API_KEY=your_github_api_key_here

# =============================================================================
# SETUP INSTRUCTIONS
# =============================================================================
#
# 1. Copy this file to .env.local:
#    cp .env.local.example .env.local
#
# 2. Replace placeholder values with your actual API keys
#
# 3. Ensure .env.local is in .gitignore (it should be already)
#
# 4. Never share or commit .env.local to version control
#
# 5. For production deployment, set these environment variables
#    in your hosting platform (Vercel, Netlify, etc.)
#
# =============================================================================
# SECURITY NOTES
# =============================================================================
#
# NEXT_PUBLIC_ vs Server-Side Variables:
#
# ✅ NEXT_PUBLIC_* variables:
#    - Exposed to browser (accessible in client-side code)
#    - Use for: API URLs, public configuration, feature flags
#    - Example: NEXT_PUBLIC_API_BASE_URL
#
# ✅ Server-side variables (no NEXT_PUBLIC_ prefix):
#    - Only accessible on server (not in browser)
#    - Use for: API keys, secrets, database URLs
#    - Example: CONTENT_API_KEY, ANTHROPIC_API_KEY
#
# ❌ NEVER use NEXT_PUBLIC_ prefix for sensitive data
# ❌ NEVER expose API keys to client-side code
# ❌ NEVER commit this file with real keys to git
#
# Variables in this file:
# - NEXT_PUBLIC_API_BASE_URL: Public (used by browser for API requests)
# - BACKEND_API_URL: Server-side only (if needed for server-side requests)
# - All *_API_KEY: Server-side only (secrets)