# Example Local Environment Configuration (Server-Side Only)
# Copy this file to .env.local and add your actual API keys
#
# ⚠️  SECURITY WARNING: This file contains sensitive API keys
# ✅ Always keep .env.local in .gitignore (it's already ignored)
# ❌ NEVER commit .env.local to version control

# =============================================================================
# REQUIRED API KEYS (Add your actual keys here)
# =============================================================================

# Content API authentication key for backend requests
# Replace with your actual content API key
CONTENT_API_KEY=your_actual_content_api_key_here

# Backend API URL (adjust for your environment)
BACKEND_API_URL=http://127.0.0.1:2024

# Development environment
NODE_ENV=development

# =============================================================================
# AI PROVIDER API KEYS (Required for AI features)
# =============================================================================

# Anthropic API Key (for Claude models)
# Get from: https://console.anthropic.com/
# Format: sk-ant-api03-...
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Perplexity API Key (for research features)
# Get from: https://www.perplexity.ai/settings/api
# Format: pplx-...
PERPLEXITY_API_KEY=your_perplexity_api_key_here

# =============================================================================
# OPTIONAL API KEYS (Add only if needed)
# =============================================================================

# OpenAI API Key (for GPT models)
# Get from: https://platform.openai.com/api-keys
# Format: sk-proj-... or sk-...
# OPENAI_API_KEY=your_openai_api_key_here

# Google AI API Key (for Gemini models)
# Get from: https://makersuite.google.com/app/apikey
# GOOGLE_API_KEY=your_google_api_key_here

# Mistral AI API Key
# Get from: https://console.mistral.ai/
# MISTRAL_API_KEY=your_mistral_api_key_here

# xAI API Key (for Grok models)
# Get from: https://x.ai/
# XAI_API_KEY=your_xai_api_key_here

# Groq API Key (for fast inference)
# Get from: https://console.groq.com/keys
# GROQ_API_KEY=your_groq_api_key_here

# OpenRouter API Key (for multiple models)
# Get from: https://openrouter.ai/keys
# OPENROUTER_API_KEY=your_openrouter_api_key_here

# Azure OpenAI API Key
# Get from: Azure Portal
# AZURE_OPENAI_API_KEY=your_azure_openai_api_key_here

# Ollama API Key (for remote Ollama servers)
# Only needed for remote servers requiring authentication
# OLLAMA_API_KEY=your_ollama_api_key_here

# GitHub API Key (for import/export features)
# Get from: https://github.com/settings/tokens
# Format: ghp_... or github_pat_...
# GITHUB_API_KEY=your_github_api_key_here

# =============================================================================
# SETUP INSTRUCTIONS
# =============================================================================
#
# 1. Copy this file to .env.local:
#    cp .env.local.example .env.local
#
# 2. Replace placeholder values with your actual API keys
#
# 3. Ensure .env.local is in .gitignore (it should be already)
#
# 4. Never share or commit .env.local to version control
#
# 5. For production deployment, set these environment variables
#    in your hosting platform (Vercel, Netlify, etc.)
#
# =============================================================================
# SECURITY NOTES
# =============================================================================
#
# ✅ These variables are server-side only (no NEXT_PUBLIC_ prefix)
# ✅ Not accessible to client-side JavaScript
# ✅ Only available during build time and server runtime
# ✅ Properly secured from client-side exposure
#
# ❌ Never use NEXT_PUBLIC_ prefix for sensitive data
# ❌ Never expose API keys to client-side code
# ❌ Never commit this file with real keys to git