# Example Environment Configuration
# Copy this file to .env for basic setup
#
# For development setup:
# 1. Copy this file to .env
# 2. Copy .env.local.example to .env.local
# 3. Add your actual API keys to .env.local

# =============================================================================
# PUBLIC CONFIGURATION (Safe for version control)
# =============================================================================

# Development environment
NODE_ENV=development

# API Base URL for client-side requests (accessible in browser)
# This MUST have NEXT_PUBLIC_ prefix to be accessible in client-side code
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:2024

# Feature flag: set to "true" to enable the organic user onboarding modal
# When false (default), onboarding queries are skipped and no modal is rendered
NEXT_PUBLIC_ENABLE_ORGANIC_ONBOARDING=false

# Shopify integration connect URL (opens in new window)
NEXT_PUBLIC_SHOPIFY_CONNECT_URL=https://shopify.connectxeo.com/

# =============================================================================
# TASK MASTER CLI CONFIGURATION (Optional)
# =============================================================================
# These are optional API keys for Task Master CLI functionality
# Add these to .env.local if you plan to use Task Master features

# OPENAI_API_KEY=your_openai_api_key_here             # Optional, for OpenAI models. Format: sk-proj-...
# GOOGLE_API_KEY=your_google_api_key_here             # Optional, for Google Gemini models
# MISTRAL_API_KEY=your_mistral_key_here               # Optional, for Mistral AI models
# XAI_API_KEY=your_xai_key_here                       # Optional, for xAI models
# GROQ_API_KEY=your_groq_key_here                     # Optional, for Groq models
# OPENROUTER_API_KEY=your_openrouter_key_here         # Optional, for OpenRouter models
# AZURE_OPENAI_API_KEY=your_azure_key_here            # Optional, for Azure OpenAI models
# OLLAMA_API_KEY=your_ollama_api_key_here             # Optional, for remote Ollama servers
# GITHUB_API_KEY=your_github_api_key_here             # Optional, for GitHub import/export features

# =============================================================================
# IMPORTANT SECURITY NOTES
# =============================================================================
#
# ❌ NEVER add sensitive API keys to this file or .env
# ❌ NEVER use NEXT_PUBLIC_ prefix for sensitive data
# ✅ Always put sensitive keys in .env.local (server-side only)
# ✅ Keep .env.local in .gitignore (it's already ignored)
#
# See .env.local.example for sensitive environment variables