{
  "ci": {
    "collect": {
      "startServerCommand": "pnpm start -p 3101",
      "startServerReadyPattern": "Ready in",
      "url": [
        "http://localhost:3101/login",
        "http://localhost:3101/signup",
        "http://localhost:3101/forgot-password",
        "http://localhost:3101/verify-email",
        "http://localhost:3101/dev/primitives"
      ],
      "numberOfRuns": 3,
      "settings": {
        "preset": "desktop",
        "chromeFlags": "--no-sandbox"
      }
    },
    "assert": {
      "assertions": {
        "largest-contentful-paint": [
          "error",
          { "maxNumericValue": 2500, "aggregationMethod": "median-run" }
        ],
        "cumulative-layout-shift": [
          "error",
          { "maxNumericValue": 0.1, "aggregationMethod": "median-run" }
        ],
        "total-blocking-time": [
          "error",
          { "maxNumericValue": 200, "aggregationMethod": "median-run" }
        ]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": "lighthouse-reports"
    }
  }
}
