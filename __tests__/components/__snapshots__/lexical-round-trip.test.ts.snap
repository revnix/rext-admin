          "value": 4,
        },
        {
          "children": [
            {
              "format": 0,
              "text": "  Brand voice",
              "type": "text",
            },
          ],
          "type": "listitem",
          "value": 5,
        },
        {
          "children": [
            {
              "format": 0,
              "text": "  SEO recommendations",
              "type": "text",
            },
          ],
          "type": "listitem",
          "value": 6,
        },
        {
          "children": [
            {
              "format": 0,
              "text": "  AI rewriting",
