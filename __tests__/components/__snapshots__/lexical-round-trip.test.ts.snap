      "type": "list",
    },
    {
      "children": [
        {
          "format": 0,
          "text": "One benefit for larger editorial teams is its unlimited user model. You do not necessarily want pricing to jump every time another editor, strategist, or writer needs access.",
          "type": "text",
        },
      ],
      "type": "paragraph",
    },
    {
      "children": [
        {
          "format": 1,
          "text": "Pricing Plans",
          "type": "text",
        },
      ],
      "tag": "h3",
      "type": "heading",
    },
    {
      "children": [
        {
          "format": 0,
          "text": "Clearscope currently lists three primary plans:",
          "type": "text",
        },
      ],
      "type": "paragraph",
    },
    {
      "children": [
        {
          "children": [
            {
              "format": 0,
              "text": "  ",
              "type": "text",
            },
            {
              "format": 1,
              "text": "Essentials:",
              "type": "text",
            },
            {
              "format": 0,
              "text": " $129 per month",
