            {
              "children": [
                {
                  "children": [
                    {
                      "format": 0,
                      "text": "Get Metrics",
                      "type": "text",
                    },
                  ],
                  "type": "paragraph",
                },
              ],
              "headerState": 0,
              "type": "tablecell",
            },
            {
              "children": [
                {
                  "children": [
                    {
                      "format": 0,
                      "text": "Analyzes and visualizes content performance metrics",
                      "type": "text",
                    },
                  ],
