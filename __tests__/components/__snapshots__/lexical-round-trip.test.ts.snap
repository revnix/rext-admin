              "type": "text",
            },
          ],
          "type": "listitem",
          "value": 4,
        },
        {
          "children": [
            {
              "format": 0,
              "text": "  Unlimited users",
              "type": "text",
            },
          ],
          "type": "listitem",
          "value": 5,
        },
        {
          "children": [
            {
              "format": 0,
              "text": "  Unlimited projects",
              "type": "text",
            },
          ],
          "type": "listitem",
          "value": 6,
        },
        {
          "children": [
            {
              "format": 0,
              "text": "  Rollover credits",
              "type": "text",
            },
          ],
          "type": "listitem",
          "value": 7,
        },
        {
          "children": [
            {
              "format": 0,
              "text": "  Team training",
              "type": "text",
            },
          ],
          "type": "listitem",
          "value": 8,
        },
      ],
      "listType": "bullet",
      "tag": "ul",
      "type": "list",
    },
    {
      "children": [
        {
          "format": 0,
          "text": "For agencies, unlimited users and projects can be particularly useful. A cheap base plan becomes less attractive if every additional team member creates another fee.",
