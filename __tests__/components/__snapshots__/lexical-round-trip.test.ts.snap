            },
            {
              "children": [
                {
                  "children": [
                    {
                      "format": 0,
                      "text": "Yes",
                      "type": "text",
                    },
                  ],
                  "type": "paragraph",
                },
              ],
              "headerState": 0,
              "type": "tablecell",
            },
            {
              "children": [
                {
