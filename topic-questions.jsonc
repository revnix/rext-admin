// JSON Representation of the Simplified Topic Builder Wizard
//
// This wizard focuses on essential questions only, creating a TypeForm-like
// single-question-per-screen experience.

[
  {
    "id": "wizardMode",
    "text": "How would you like to start?",
    "type": "radio",
    "required": true,
    "options": [
      "I have a specific topic in mind",
      "I want to explore my industry"
    ]
  },
  {
    "id": "industry",
    "text": "Select your industry or domain",
    "type": "dropdown",
    "required": true,
    "options": [
      "Technology",
      "Healthcare",
      "Finance",
      "Education",
      "Travel",
      "Food",
      "Fashion",
      "Business",
      "Marketing",
      "Science",
      "Sports",
      "Lifestyle",
      "Government",
      "Real Estate",
      "E-commerce",
      "HR",
      "Legal",
      "Fitness",
      "Other"
    ]
  },
  {
    "id": "industry_other",
    "text": "Please specify the industry",
    "type": "text",
    "required": true,
    "dependsOn": { "id": "industry", "value": "Other" }
  },
  {
    "id": "subject",
    "text": "What is the main topic or subject you want content topics for?",
    "type": "text",
    "required": true,
    "dependsOn": { "id": "wizardMode", "value": "subject-first" },
    "sampleAnswers": [
      "Artificial Intelligence in healthcare",
      "Budget travel tips for students",
      "Sustainable fashion trends"
    ]
  },
  {
    "id": "audience",
    "text": "Who are you creating this for?",
    "type": "multiselect",
    "required": false,
    "maxSelections": 5,
    "sampleAnswers": [
      "Small business owners",
      "College students",
      "Working professionals",
      "New parents"
    ]
  },
  {
    "id": "purpose",
    "text": "What do you want to achieve?",
    "type": "multiselect",
    "required": true,
    "maxSelections": 3,
    "options": [
      "Educate/Inform",
      "Entertain/Engage",
      "Inspire/Motivate",
      "Persuade/Convince",
      "Promote a Product/Service",
      "Drive SEO Traffic",
      "Establish Thought Leadership",
      "Other"
    ]
  },
  {
    "id": "purpose_other",
    "text": "Please specify your purpose",
    "type": "text",
    "required": true,
    "dependsOn": { "id": "purpose", "value": "Other" }
  },
  {
    "id": "num_topics",
    "text": "How many topics do you need?",
    "type": "slider",
    "required": false,
    "min": 1,
    "max": 20,
    "default": 5,
    "note": "This is shown on the review screen"
  }
]
