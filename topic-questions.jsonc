// JSON Representation of the Simplified Topic Builder Wizard
//
// This wizard focuses on essential questions only, creating a TypeForm-like
// single-question-per-screen experience.

[
  {
    "id": "industry",
    "text": "What industry are you in?",
    "type": "dropdown",
    "required": true,
    "description": "This helps us tailor all suggestions and content topics to your specific market.",
    "options": [
      "Technology",
      "Healthcare",
      "Finance",
      "Education",
      "Travel",
      "Food",
      "Fashion",
      "Business",
      "Marketing",
      "Science",
      "Sports",
      "Lifestyle",
      "Government",
      "Real Estate",
      "E-commerce",
      "HR",
      "Legal",
      "Fitness",
      "Other"
    ]
  },
  {
    "id": "wizardMode",
    "text": "How would you like to approach topic generation?",
    "type": "radio",
    "required": true,
    "description": "Choose your preferred brainstorming approach based on your current needs.",
    "options": [
      "I have a specific topic in mind",
      "I want to explore my industry"
    ]
  },
  {
    "id": "industry_other",
    "text": "Please specify the industry",
    "type": "text",
    "required": true,
    "dependsOn": { "id": "industry", "value": "Other" }
  },
  {
    "id": "subject",
    "text": "What specific topic do you want content for?",
    "type": "text",
    "required": true,
    "description": "Be as specific as possible. This will help us generate more targeted topics.",
    "dependsOn": { "id": "wizardMode", "value": "subject-first" },
    "sampleAnswers": [
      "AI implementation strategies for small businesses",
      "Telemedicine adoption best practices",
      "Digital marketing strategies for small restaurants"
    ]
  },
  {
    "id": "audience",
    "text": "Who is your target audience?",
    "type": "multiselect",
    "required": false,
    "description": "Describe the people you want to reach with your content.",
    "maxSelections": 5,
    "sampleAnswers": [
      "Small business owners",
      "Marketing professionals",
      "Healthcare administrators",
      "Technology decision makers"
    ]
  },
  {
    "id": "purpose",
    "text": "What do you want to achieve?",
    "type": "multiselect",
    "required": true,
    "maxSelections": 3,
    "options": [
      "Educate/Inform",
      "Entertain/Engage",
      "Inspire/Motivate",
      "Persuade/Convince",
      "Promote a Product/Service",
      "Drive SEO Traffic",
      "Establish Thought Leadership",
      "Other"
    ]
  },
  {
    "id": "purpose_other",
    "text": "Please specify your purpose",
    "type": "text",
    "required": true,
    "dependsOn": { "id": "purpose", "value": "Other" }
  },
  {
    "id": "num_topics",
    "text": "How many topics do you need?",
    "type": "slider",
    "required": false,
    "min": 1,
    "max": 20,
    "default": 5,
    "note": "This is shown on the review screen"
  }
]
